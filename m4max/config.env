# M4 Max defaults for this fork (m4max/setup.sh warns on other chips). Measured on: chip="Apple M4 Max" generation=M4 memory_gb=36 macos=26.7 nax_capable=no
# Kernel knobs (A/B tested on M4 Max, bit-identical tokens):
# single-row 2-bit GEMV reading FP16 constants as stored (-6.6% decode step)
MLXFAST_BONSAI_QMV2=1
MLXFAST_QMV2_R=4
MLXFAST_QMV2_SGS=4
# 64x64 qmm tiles for prompt-width matmuls on non-NAX GPUs (+10% prefill)
MLXFAST_QMM_BM=64
MLXFAST_QMM_BN=64
# Qwen35TensorPackedMatmul (tensor-unit route) is M5-only; it corrupts output on M4.
DARKBLOOM_BONSAI_TENSOR_ROUTE=0
# DFlash2TensorMatmul (drafter) is M5-only; on M4 it drives acceptance to 0%.
DARKBLOOM_DFLASH2_TENSOR_MATMUL=0
# Do not pad verify-width rows to 13 (an M5 NAX threshold): on M4 it moves an 8-row
# verify from qmv_wide to the 32-row tile at twice the cost (DFlash 16.6 -> 52.7 tok/s).
MLXFAST_MATRIX_MIN_ROWS=1
# DFlash 2 at depth 3: best on code (52.7 tok/s vs 37.6 serial), ~even on prose.
BONSAI_SPEC=dflash
BONSAI_DEPTH=3
